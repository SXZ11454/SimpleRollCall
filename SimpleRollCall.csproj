<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworks>net8.0-windows;net6.0-windows</TargetFrameworks>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>SRC.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <FileVersion>1.0.0.0</FileVersion>
    <AssemblyVersion>1.0.0.0</AssemblyVersion>
    <!-- Windows File Property -->
    <AssemblyTitle>SimpleRollCall</AssemblyTitle>
    <Product>SimpleRollCall</Product>
    <Company>SXZ11454</Company>
    <Authors>SXZ11454</Authors>
    <Copyright>Copyright 2026 SXZ11454. All rights reserved.</Copyright>
    <Description>A simple WPF roll call application.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModernWpfUI" Version="0.9.6" />
  </ItemGroup>

</Project>
