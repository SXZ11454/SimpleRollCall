<Window x:Class="SimpleRollCall.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:SimpleRollCall"
        xmlns:ui="http://schemas.modernwpf.com/2019"
        xmlns:res="clr-namespace:SimpleRollCall.Properties"
        ui:WindowHelper.UseModernWindowStyle="True"
        mc:Ignorable="d"
        Title="{x:Static res:Resources.WindowTitle}" Height="640" Width="500" MinWidth="500" MinHeight="640"
        local:PressScale.Enabled="True">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="80"/>
        </Grid.RowDefinitions>

        <!-- Top: fills all remaining space; the draw text scales with the window
             (Viewbox only shrinks, never enlarges, so the natural size is the max font size) -->
        <Grid Grid.Row="0">
            <Viewbox x:Name="DisplayBox" Stretch="Uniform" StretchDirection="DownOnly" Margin="24">
                <Grid>
                    <TextBlock x:Name="SingleText" FontSize="48" FontWeight="Bold"
                               Text="{x:Static res:Resources.Waiting}"/>
                    <WrapPanel x:Name="MultiPanel" Visibility="Collapsed" MaxWidth="1000"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Grid>
            </Viewbox>
        </Grid>

        <!-- Middle: progress bar strip, fixed height 10, sits right above the bottom toolbar -->
        <StackPanel Grid.Row="1" Height="10" VerticalAlignment="Bottom">
            <ProgressBar x:Name="DrawProgress" Height="10" Margin="20,0" Value="0" IsIndeterminate="False"/>
        </StackPanel>

        <!-- Bottom: fixed height 80, toolbar -->
        <StackPanel Grid.Row="2" VerticalAlignment="Center">
            <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
                <!-- Backdrop rectangle for the button group: fill matches the default button
                     background and picks colors dynamically from the theme.
                     Square corners (no RadiusX/RadiusY) like every other control. -->
                <Rectangle Fill="{DynamicResource ButtonBackground}"/>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="PlayButton" Style="{DynamicResource AccentButtonStyle}" Width="48" Height="40"
                            ToolTip="{x:Static res:Resources.StartTooltip}" Click="PlayButton_Click">
                        <ui:SymbolIcon Symbol="Play"/>
                    </Button>
                    <Rectangle Width="1" Height="24" Fill="{DynamicResource ButtonBorderBrush}"/>
                    <Button x:Name="ResetButton" Width="48" Height="40" Background="Transparent" BorderThickness="0"
                            ToolTip="{x:Static res:Resources.ResetTooltip}" Click="ResetButton_Click">
                        <ui:SymbolIcon Symbol="Refresh"/>
                    </Button>
                    <Rectangle Width="1" Height="24" Fill="{DynamicResource ButtonBorderBrush}"/>
                    <!-- Multi-account: opens a Flyout containing the draw-count input -->
                    <Button x:Name="PeopleButton" Width="48" Height="40" Background="Transparent" BorderThickness="0"
                            ToolTip="{x:Static res:Resources.MultiAccountTooltip}">
                        <ui:FlyoutService.Flyout>
                            <ui:Flyout Placement="Top">
                                <StackPanel Orientation="Horizontal" Margin="4">
                                    <TextBlock x:Name="PeopleCountLabel" Text="{x:Static res:Resources.PeopleCount}"
                                               VerticalAlignment="Center" Margin="0,0,8,0"/>
                                    <ui:NumberBox x:Name="PeopleCountBox" Value="1" Minimum="1" Maximum="10" Width="140"
                                                  SpinButtonPlacementMode="Compact" VerticalAlignment="Center"/>
                                </StackPanel>
                            </ui:Flyout>
                        </ui:FlyoutService.Flyout>
                        <ui:SymbolIcon Symbol="People"/>
                    </Button>
                    <Rectangle Width="1" Height="24" Fill="{DynamicResource ButtonBorderBrush}"/>
                    <Button x:Name="SettingsButton" Width="48" Height="40" Background="Transparent" BorderThickness="0"
                            ToolTip="{x:Static res:Resources.SettingsTooltip}" Click="SettingsButton_Click">
                        <ui:SymbolIcon Symbol="Setting"/>
                    </Button>
                </StackPanel>
            </Grid>
        </StackPanel>

        <!-- Full screen settings host: covers the whole window and is collapsed again
             as soon as SettingsPage sends the user back (no ContentDialog involved) -->
        <Frame x:Name="RootFrame" Grid.Row="0" Grid.RowSpan="3" Background="{DynamicResource ApplicationPageBackgroundThemeBrush}"
               Visibility="Collapsed" NavigationUIVisibility="Hidden"/>

    </Grid>
</Window>
